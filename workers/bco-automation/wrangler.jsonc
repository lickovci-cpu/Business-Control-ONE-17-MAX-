{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bco-automation-preview",
  "main": "src/index.js",
  "compatibility_date": "2026-11-21",
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  }
}
